<?xml version="1.0" encoding="utf-8"?>
<!--
  Power Nap — Jarvis design system.
  Single-screen layout: no ScrollView. Root LinearLayout fills the screen
  and distributes leftover vertical space across three weighted Space views
  (ratio 2 : 1 : 1), so the layout scales cleanly from ~580 dp to 900 dp.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="28dp"
    android:background="@color/bg_void">

    <!-- ── 01 · Header ─────────────────────────────────── -->

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="POWER NAP"
        android:textColor="@color/accent_signal"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:letterSpacing="0.2" />

    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.0 · READY"
        android:textColor="@color/text_dim"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:layout_marginTop="3dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_default"
        android:layout_marginTop="12dp" />

    <!-- Flexible gap — weight=2 so timer stays in upper-centre -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2" />

    <!-- ── 02 · Timer display ──────────────────────────── -->

    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textColor="@color/text_frost"
        android:textSize="72sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:gravity="center"
        android:letterSpacing="0.04"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TAP TO ADD MINUTES"
        android:textColor="@color/text_dim"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.15"
        android:gravity="center"
        android:layout_marginTop="6dp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/timerProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:trackColor="@color/border_default"
        app:indicatorColor="@color/accent_signal"
        app:trackCornerRadius="2dp"
        android:progress="0"
        android:max="10000" />

    <!-- Flexible gap — weight=1 -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ── 03 · Quick-add buttons ─────────────────────── -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn1"
            style="@style/Widget.PowerNap.Button.Add"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="1"
            android:layout_marginEnd="5dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn5"
            style="@style/Widget.PowerNap.Button.Add"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="5"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn10"
            style="@style/Widget.PowerNap.Button.Add"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="10"
            android:layout_marginStart="5dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn25"
            style="@style/Widget.PowerNap.Button.Add"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="25"
            android:layout_marginEnd="5dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn50"
            style="@style/Widget.PowerNap.Button.Add"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="50"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn90"
            style="@style/Widget.PowerNap.Button.Add"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="90"
            android:layout_marginStart="5dp" />
    </LinearLayout>

    <!-- ── 04 · Alarm sound ───────────────────────────── -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ALARM SOUND"
        android:textColor="@color/accent_signal"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.18"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSound0"
            style="@style/Widget.PowerNap.Button.Sound"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="——"
            android:layout_marginEnd="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSound1"
            style="@style/Widget.PowerNap.Button.Sound"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="——"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSound2"
            style="@style/Widget.PowerNap.Button.Sound"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="——"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSound3"
            style="@style/Widget.PowerNap.Button.Sound"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="——"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- ── 05 · Volume ramp ───────────────────────────── -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WAKE RAMP"
        android:textColor="@color/accent_signal"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.18"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRamp0"
            style="@style/Widget.PowerNap.Button.Sound"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="OFF"
            android:layout_marginEnd="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRamp1"
            style="@style/Widget.PowerNap.Button.Sound"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="15S"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRamp2"
            style="@style/Widget.PowerNap.Button.Sound"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="30S"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRamp3"
            style="@style/Widget.PowerNap.Button.Sound"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="60S"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- ── 06 · Bluetooth status ──────────────────────── -->

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp">

        <View
            android:id="@+id/btDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/circle_dot"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvBtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PHONE SPEAKER"
            android:textColor="@color/text_dim"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12" />
    </LinearLayout>

    <!-- Flexible gap — weight=1, sits between status and buttons -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ── 07 · Action buttons ────────────────────────── -->

    <!--
      btnMain: START (idle) → STOP (running) → STOP ALARM (alarm ringing).
      Text, color, and click behaviour all change via enterXxxState().
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMain"
        style="@style/Widget.PowerNap.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="START" />

    <!--
      btnSnooze: GONE until alarm fires. Setting GONE here means it takes
      no space in the layout until enterAlarmState() makes it VISIBLE.
      On alarm, the three Space views absorb the 62 dp shift.
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSnooze"
        style="@style/Widget.PowerNap.Button.Snooze"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="SNOOZE · 9 MIN"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="20dp" />

</LinearLayout>
